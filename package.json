{
  "name": "cloudflare-billing-helper",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cloudflare-billing-helper/extension dev",
    "build": "pnpm build:extension",
    "build:extension": "pnpm --filter @cloudflare-billing-helper/extension build && node apps/extension/scripts/sync-legacy-build.mjs",
    "build:macos": "bash apps/macos/scripts/build.sh",
    "archive:macos:direct": "bash apps/macos/scripts/archive-direct.sh",
    "package:macos:direct": "bash apps/macos/scripts/package-direct.sh",
    "zip": "pnpm --filter @cloudflare-billing-helper/extension zip",
    "version:extension": "pnpm --filter @cloudflare-billing-helper/extension version:patch",
    "compile": "pnpm --filter @cloudflare-billing-helper/extension compile",
    "test": "pnpm test:extension && pnpm test:macos",
    "test:extension": "pnpm --filter @cloudflare-billing-helper/extension test",
    "test:macos": "swift test --package-path apps/macos/Packages/BillingCore && swift test --package-path apps/macos",
    "repro": "pnpm --filter @cloudflare-billing-helper/extension repro",
    "screenshots": "pnpm --filter @cloudflare-billing-helper/extension screenshots",
    "promo": "pnpm --filter @cloudflare-billing-helper/extension promo"
  }
}
